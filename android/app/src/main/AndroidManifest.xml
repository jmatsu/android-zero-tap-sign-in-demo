<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The manifest side of Zero-Tap Sign-In is four attributes, and it is easy to
      get most of the way there and then wonder why nothing arrives on device B.

        allowBackup            Auto Backup must be on. With it off, no app data
                               travels and the Restore Key has nothing to ride
                               along with.
        backupAgent            Gives us onRestoreFinished, where the sign-in
                               happens before the user ever opens the app.
                               Strictly optional — drop it and the sign-in still
                               works on first launch, it is just fast rather than
                               zero-tap.
        fullBackupOnly         Leaves Auto Backup in charge of moving the data,
                               so the agent above exists purely for its restore
                               callback and never implements key/value backup.
        dataExtractionRules    Android 12+, with fullBackupContent covering 11
        fullBackupContent      and below. Both exclude the session token; see
                               those files for why that exclusion is what makes
                               the flow honest.

      Note what is absent: the Restore Key itself is not app data and is listed
      nowhere here. Credential Manager backs it up through the platform's own
      end-to-end encrypted channel, keyed to the package name — which is also
      why the package name must not change between the two devices.
    -->
    <application
        android:name=".ZeroTapApp"
        android:allowBackup="true"
        android:backupAgent=".backup.ZeroTapBackupAgent"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:fullBackupOnly="true"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZeroTap">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
